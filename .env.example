# ===== AshareSignal Lab 环境配置示例 =====
# 复制为 .env 并按需修改。真实密钥不得提交到 Git。

# --- 数据库 ---
# 本地默认 SQLite（零依赖可跑测试与演示）；生产/完整部署建议 PostgreSQL（见 docker-compose.yml）
ASG_DATABASE_URL=sqlite:///./data/ashare_lab.db

# --- 对象存储（研究数据 Parquet）---
# 本地文件系统适配器默认即可；接口兼容 S3/MinIO
ASG_ARTIFACT_BACKEND=local
ASG_ARTIFACT_ROOT=./data/artifacts
# ASG_S3_ENDPOINT=http://localhost:9000
# ASG_S3_BUCKET=asg-artifacts
# ASG_S3_ACCESS_KEY=...
# ASG_S3_SECRET_KEY=...

# --- LLM provider（可选）---
# 未配置时自动降级为确定性 mock provider，系统全部功能仍可测试
ASG_LLM_PROVIDER=mock
ASG_LLM_BASE_URL=
ASG_LLM_API_KEY=
ASG_LLM_MODEL=
ASG_LLM_TIMEOUT_SECONDS=60
ASG_LLM_MAX_RETRIES=2
ASG_LLM_BUDGET_CNY=0

# --- API 服务 ---
ASG_API_HOST=127.0.0.1
ASG_API_PORT=8300
ASG_SECRET_KEY=change-me-to-a-long-random-string
ASG_ACCESS_TOKEN_EXPIRE_MINUTES=720
ASG_RATE_LIMIT_PER_MINUTE=120

# --- 合规与安全 ---
ASG_ALLOW_REAL_TRADING=false
ASG_ALLOW_REMOTE_FETCH=false
